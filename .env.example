DATABASE_URL=
DATABASE_URL_TEST=
PORT=4200
API_KEY=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_SOURCING=
ELEVENLABS_SIP_PHONE_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Google Maps Geocoding (accurate location resolution); falls back to free Nominatim if empty.
GOOGLE_MAPS_API_KEY=
COMPANY_NAME=Pinified
MAX_CONCURRENT=2
MAX_ATTEMPTS=2

# --- Deployment (docker-compose on OVH) ---
# Postgres container credentials (compose builds DATABASE_URL from these).
PG_USER=sourcing
PG_PASSWORD=
PG_DB=vehicle_sourcing
# Public domain that resolves to the host — Caddy gets a TLS cert for it and it
# becomes the ElevenLabs webhook base. Set PUBLIC_BASE_URL=https://$PUBLIC_DOMAIN.
PUBLIC_DOMAIN=
