DATABASE_URL=
DATABASE_URL_TEST=
PORT=4200
API_KEY=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_SOURCING=
ELEVENLABS_SIP_PHONE_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Google Maps Geocoding (accurate location resolution); falls back to free Nominatim if empty.
GOOGLE_MAPS_API_KEY=
COMPANY_NAME=Pinified
MAX_CONCURRENT=2
MAX_ATTEMPTS=2

# --- Deployment (docker-compose on OVH) ---
# Postgres container credentials (compose builds DATABASE_URL from these).
PG_USER=sourcing
PG_PASSWORD=
PG_DB=vehicle_sourcing
# Public domain that resolves to the host — Caddy gets a TLS cert for it and it
# becomes the ElevenLabs webhook base. Set PUBLIC_BASE_URL=https://$PUBLIC_DOMAIN.
PUBLIC_DOMAIN=
# Voice-agent public host (Plivo Answer URL + wss media stream). A sslip.io
# sub-host pointing at this box, e.g. voice.148-113-58-30.sslip.io
VOICE_DOMAIN=
# Groq (free) — Whisper Hindi STT + LLM for the India voice agent
GROQ_API_KEY=

# --- WhatsApp channel (Interakt) ---
# API key from Interakt dashboard (Basic auth token). WA channel is off without it.
INTERAKT_API_KEY=
# "Verify token" from the Interakt webhook config — signs inbound webhooks.
INTERAKT_WEBHOOK_SECRET=
INTERAKT_COUNTRY_CODE=+91
WA_ENABLED=true
# minutes before an unanswered WhatsApp offer is closed as NO_ANSWER
WA_REPLY_TTL_MIN=30
# free-text load parsing for WhatsApp intake (optional; guided flow without it)
# — reuses GROQ_API_KEY set above; only the model differs
GROQ_MODEL=llama-3.3-70b-versatile

# --- Driver documents (LR/invoice photos over WhatsApp) ---
# vision extraction; without a key docs are stored unprocessed for manual review
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-12b-2409
LR_CREATE_DAILY_CAP=5
DOC_MAX_BYTES=8388608

# --- Email channel (IMAP poll + SMTP send) ---
# Enabled iff IMAP_USER + IMAP_PASSWORD are set AND EMAIL_ENABLED isn't off.
EMAIL_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_POLL_SECONDS=30
EMAIL_REPLY_TTL_MIN=120
